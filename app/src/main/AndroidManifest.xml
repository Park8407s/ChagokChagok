<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 차량 권한(차속·기어·깜빡이)과 Foreground Service 권한은 M1 에서 기록 서비스와 함께 추가한다. -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TodaysOST">

        <!-- 메인 화면. distractionOptimized 를 선언하지 않는다:
             주행 중에는 플랫폼(CarUxRestrictions)이 앱 화면을 가리고, 주차하면 다시 보인다.
             (1차 범위: 주행 중에는 화면·소리 없이 기록만 함) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
